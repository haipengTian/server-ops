# 先运行 bash init.sh <个人镜像版本或摘要>，只在服务器本地生成密钥。
# 格式为 KEY=value；不使用引号、变量展开或行尾注释。
SUB2API_IMAGE=
SUB2API_DOMAIN=proxy.thpvip.xyz
SUB2API_HOST_PORT=8088
SUB2API_DATA_DIR=/opt/sub2api
SUB2API_WAIT_SECONDS=300
COMPOSE_PROJECT_NAME=sub2api-custom
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
# 必须填写自己实际使用的管理员邮箱；密码由 init.sh 生成。
ADMIN_EMAIL=
ADMIN_PASSWORD=
TZ=Asia/Shanghai
SUB2API_MEM_LIMIT=1536m
SUB2API_CPUS=1.5
POSTGRES_MEM_LIMIT=768m
POSTGRES_CPUS=1
REDIS_MEM_LIMIT=256m
REDIS_CPUS=0.5
