# 先运行 init.sh，镜像由自己的 Toonflow-app 仓库发布。
TOONFLOW_IMAGE=
TOONFLOW_HOST_PORT=3014
TOONFLOW_DATA_DIR=/opt/toonflow
TOONFLOW_WAIT_SECONDS=180
COMPOSE_PROJECT_NAME=toonflow-custom
TOONFLOW_MEM_LIMIT=2g
TOONFLOW_CPUS=2
TOONFLOW_AUTH_ENABLED=true
TOONFLOW_PUBLIC_ORIGIN=https://toonflow.thpvip.xyz
TOONFLOW_AUTH_USERNAME=admin
TOONFLOW_AUTH_PASSWORD_HASH=
TZ=Asia/Shanghai
