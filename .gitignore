# 服务器上生成的文件不进仓库
.env
!.env.example
data/

# Sub2API 服务器本地密钥、操作锁与临时配置
sub2api/.env.*
!sub2api/.env.example
sub2api/.operation.lock
sub2api/.transaction.*

imgbed/.env.*
!imgbed/.env.example
imgbed/.operation.lock
imgbed/.transaction.*

cliproxyapi/.env.*
!cliproxyapi/.env.example
cliproxyapi/.operation.lock
cliproxyapi/.transaction.*
cliproxyapi/**/__pycache__/
