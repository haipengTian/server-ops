+
+    assert required_stop in prompt
+    assert no_empty_output in prompt
+    assert old_no_tool_rule not in prompt
+
+
+def test_planner_final_reminder_keeps_explicit_stop_contract(monkeypatch: pytest.MonkeyPatch) -> None:
