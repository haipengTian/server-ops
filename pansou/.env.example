# 首次启动前由 init.sh 填入固定镜像、完整频道/插件清单及 JWT 密钥。
PANSOU_IMAGE=ghcr.io/haipengtian/pansou-web:sha-420b940
PANSOU_DOMAIN=sou.thpvip.cn
PANSOU_HOST_PORT=9000
PANSOU_DATA_DIR=/opt/pansou
PANSOU_WAIT_SECONDS=180
COMPOSE_PROJECT_NAME=pansou
TZ=Asia/Shanghai
PANSOU_MEM_LIMIT=1g
PANSOU_CPUS=2

# 由你在服务器填写：用户名:密码。只配置一个救急管理员；普通账号在后台创建。
# 用户名 3-32 位字母/数字/._-；密码 16-72 位字母/数字/._!@%+=-。
ADMIN_USERS=
AUTH_JWT_SECRET=
CERTBOT_EMAIL=

# 这两项只在首次启动时播种；之后请在管理后台调整，不要删 settings.json。
CHANNELS=
ENABLED_PLUGINS=
